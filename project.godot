; Engine configuration file.

config_version=5

[application]

config/name="110: City Watch"
config/description="江城市公安指挥调度模拟"
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")
boot_splash/bg_color=Color(0.01, 0.02, 0.035, 1)
boot_splash/show_image=false
config/icon="res://icon.svg"

[autoload]

GameState="*res://scripts/core/game_state.gd"
Data="*res://scripts/core/data.gd"
DevTools="*res://scripts/dev/dev_tools.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=2
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/default_font_antialiasing=1

[rendering]

anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=1
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
environment/defaults/default_clear_color=Color(0.012, 0.018, 0.03, 1)
textures/default_filters/anisotropic_filtering_level=3

[shader_globals]

night_factor={
"type": "float",
"value": 1.0
}
